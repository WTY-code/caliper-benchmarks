test:
  workers:
    number: 5
  rounds:
    - label: Create a car.
      # 5000 transactions should create around 1000 cars per worker but not guaranteed
      # so need to set asset limits to less than 1000 for the other tests
      txNumber: 5000
      rateControl:
          type: fixed-rate
          opts:
            tps: 500
      workload:
        module: benchmarks/samples/fabric/fabcar/createCar.js
monitors:
  resource:
  - module: process
    options:
      interval: 3
      processes: [{ command: 'node', arguments: 'caliper.js', multiOutput: 'avg' }]
  - module: docker
    options:
      interval: 5
      cpuUsageNormalization: true
      containers:
      - all
  - module: prometheus
    options:
      url: "http://localhost:9090"
      metrics:
          include: [dev-.*, couch, peer, orderer]
          queries:
              - name: Endorse Time (s)
                query: rate(endorser_propsal_duration_sum{chaincode="fabcar"}[1m])/rate(endorser_propsal_duration_count{chaincode="fabcar"}[1m])
                step: 1
                label: instance
                statistic: avg
              - name: Max Memory (MB)
                query: sum(container_memory_rss{name=~".+"}) by (name)
                step: 10
                label: name
                statistic: max
                multiplier: 0.000001

